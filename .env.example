# Local Ollama. Keep CAG_NUM_CTX constant: changing it reloads the model and drops the KV cache.
CAG_OLLAMA_HOST=http://127.0.0.1:11435   # dedicated instance: OLLAMA_HOST=127.0.0.1:11435 OLLAMA_NUM_PARALLEL=1 ollama serve
CAG_MODEL=qwen3:8b
CAG_NUM_CTX=32768
CAG_KEEP_ALIVE=60m
CAG_DATASET=helpdesk
CAG_MAX_DOCS=200
