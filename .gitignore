# environment and tooling
.venv/
.env
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
.DS_Store

# generated at run time: eval reports, per-question outputs, logs, caches
reports/*
!reports/.gitkeep
data/.embed_cache.json
corpus/versions/
*.log

# local "second brain" files (Graphify + Obsidian workflow): generated or personal, contain absolute paths; never committed
graphify-out/
.graphifyignore
BRAINS.md
Session_Logs.md
vault/
.gitattributes
.claude/

# companion video: large or regenerable build output
docs/video/anim/node_modules
docs/video/anim/out/
docs/video/anim/public/narration/*.wav
docs/video/upload/*.mp4
docs/video/upload/*.png
docs/video/narration/.venv/
